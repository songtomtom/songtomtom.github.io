---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
import { getProjects } from "@lib/projects";

const hasProjects = (await getProjects()).length > 0;
type Props = { wide?: boolean };
const { wide = false } = Astro.props;
---

<header transition:persist>
  <Container wide={wide}>
    <div class="flex flex-wrap justify-between gap-y-2">
      <Link href="/" underline={false}>
        <div class="font-semibold">
          {SITE.TITLE}
        </div>
      </Link>
      <nav class="font-ui flex items-center gap-1 text-sm">
        <Link href="/blog">글</Link>
        <span>
          {`/`}
        </span>
        <Link href="/series">시리즈</Link>
        <span>
          {`/`}
        </span>
        {
          hasProjects && (
            <>
              <Link href="/projects">프로젝트</Link>
              <span>{`/`}</span>
            </>
          )
        }
        <Link href="/resume">이력서</Link>
        <span>
          {`/`}
        </span>
        <button
          id="magnifying-glass"
          aria-label="Search"
          class="text-current underline decoration-black/30 underline-offset-[3px] transition-colors duration-300 ease-in-out hover:text-black hover:decoration-black/50 dark:decoration-white/30 dark:hover:text-white dark:hover:decoration-white/50"
        >
          검색
        </button>
      </nav>
    </div>
  </Container>
</header>

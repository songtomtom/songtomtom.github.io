---
// 글 한 줄. 제목 왼쪽, 날짜 오른쪽. 부모 <ul class="row-list"> 안에서 쓴다.
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog">;
  /** 설명 한 줄을 같이 보일지. 홈·연도 목록에서는 끈다 */
  withDescription?: boolean;
};

const { entry, withDescription = false } = Astro.props as Props;
const { title, description, date } = entry.data;
const ym = `${date.getFullYear()}년 ${date.getMonth() + 1}월`;
---

<a href={`/${entry.collection}/${entry.id}`} class="row group block">
  <span class="grid grid-cols-1 items-baseline gap-x-5 gap-y-0.5 sm:grid-cols-[minmax(0,1fr)_auto]">
    <span class="text-[#282828] group-hover:text-black dark:text-[#e2ded6] dark:group-hover:text-white">{title}</span>
    <time class="row-meta" datetime={date.toISOString().slice(0, 7)}>{ym}</time>
  </span>
  {withDescription && <span class="mt-0.5 block text-sm text-[#676767] dark:text-[#8a867e]">{description}</span>}
</a>

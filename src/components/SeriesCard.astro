---
// 시리즈 한 줄. 제목 왼쪽, 편수·연도 오른쪽, 아래에 설명 한 줄. 부모 <ul class="row-list"> 안에서 쓴다.
import type { CollectionEntry } from "astro:content";

type Props = {
  series: CollectionEntry<"series">;
  postCount: number;
};

const { series, postCount } = Astro.props;
const { title, description, tech, date } = series.data;
---

<a href={`/series/${series.id}`} class="row group block">
  <span class="grid grid-cols-1 items-baseline gap-x-5 gap-y-0.5 sm:grid-cols-[minmax(0,1fr)_auto]">
    <span class="text-[#282828] group-hover:text-black dark:text-[#e2ded6] dark:group-hover:text-white">{title}</span>
    <span class="row-meta">{postCount > 0 && `${postCount}편 · `}{date.getFullYear()}</span>
  </span>
  <span class="mt-0.5 block text-sm text-[#676767] dark:text-[#8a867e]">{description}</span>
  {tech && tech.length > 0 && <span class="row-meta mt-1 block text-xs">{tech.join(" · ")}</span>}
</a>

---
import type { CollectionEntry } from "astro:content";
import CoverThumb from "@components/CoverThumb.astro";
import TechChips from "@components/TechChips.astro";

type Props = { project: CollectionEntry<"projects"> };

const { project } = Astro.props;
const { title, description, org, date, endDate, categories, tech, cover } = project.data;
const ym = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}`;
---

<a
  href={`/projects/${project.id}`}
  class="not-prose group flex flex-col overflow-hidden rounded-lg border border-black/15 transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
>
  <CoverThumb cover={cover} category={categories?.[0]} width={720} class="border-b border-black/10 dark:border-white/10" />
  <div class="flex flex-1 flex-col gap-1 px-3.5 py-3">
    <span class="font-semibold">{title}</span>
    <span class="text-sm">{description}</span>
    <span class="text-xs text-neutral-500">
      {org && `${org} · `}<span class="tabular-nums">{ym(date)} – {endDate ? ym(endDate) : "현재"}</span>
    </span>
    <TechChips tech={tech} class="mt-1.5" />
  </div>
</a>

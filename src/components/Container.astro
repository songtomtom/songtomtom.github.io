---
// 본문 컨테이너. 사이트 전체 폭은 1120px 로 통일한다(홈·글·시리즈·이력서 모두 같은 폭).
// narrow: 글 본문처럼 읽는 폭이 중요한 곳만 768px 로 좁힌다. 헤더·푸터는 항상 1120px.
import { cn } from "@lib/utils";
type Props = { narrow?: boolean; wide?: boolean };
const { narrow = false } = Astro.props;
---

<div class={cn("mx-auto px-4", narrow ? "max-w-3xl" : "max-w-[1120px]")}><slot /></div>

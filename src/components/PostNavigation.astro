---
// 글 아래의 이전·다음 글 링크. 얇은 윗선 아래에 글 제목 링크 두 개만 둔다.
import Link from "@components/Link.astro";

const { prevPost, nextPost } = Astro.props;
---

<nav class="not-prose grid grid-cols-1 gap-x-8 gap-y-4 border-t border-black/10 pt-5 sm:grid-cols-2 dark:border-white/10" aria-label="이전·다음 글">
  <div class="min-w-0">
    {
      prevPost?.id && (
        <>
          <div class="row-meta mb-1 text-xs">← 이전 글</div>
          <Link href={`/blog/${prevPost.id}`}>{prevPost.data.title}</Link>
        </>
      )
    }
  </div>
  <div class="min-w-0 sm:text-right">
    {
      nextPost?.id && (
        <>
          <div class="row-meta mb-1 text-xs">다음 글 →</div>
          <Link href={`/blog/${nextPost.id}`}>{nextPost.data.title}</Link>
        </>
      )
    }
  </div>
</nav>

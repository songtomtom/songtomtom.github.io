---
import { render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import Link from "@components/Link.astro";
import Mermaid from "@components/Mermaid.astro";
import CategoryBadge from "@components/CategoryBadge.astro";
import { Image } from "astro:assets";
import { getProjects, type Project } from "@lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, next: projects[i + 1] ?? projects[0] },
  }));
}
type Props = { project: Project; next?: Project };

const { project, next } = Astro.props;
const { Content } = await render(project);
const { title, description, org, role, date, endDate, categories, tech, links, stats, cover } = project.data;
const ym = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}`;
---

<Layout title={title} description={description}>
  <Container>
    <div class="animate">
      <BackToPrevious href="/projects">프로젝트 목록으로</BackToPrevious>
    </div>
    <div class="animate my-10 space-y-3">
      {org && <p class="text-xs uppercase tracking-wider text-neutral-500">프로젝트 · {org}</p>}
      <h1 class="text-3xl font-semibold text-black dark:text-white">{title}</h1>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-neutral-500">
        <span class="flex gap-1">{categories?.map((c) => <CategoryBadge category={c} />)}</span>
        <span class="tabular-nums">{ym(date)} – {endDate ? ym(endDate) : "현재"}</span>
        {role && <span>{role}</span>}
      </div>
      <p class="text-black dark:text-white">{description}</p>
      {
        links?.length && (
          <p class="flex flex-wrap gap-x-4 text-sm">
            {links.map((l) => (
              <Link href={l.href} external>{l.label}</Link>
            ))}
          </p>
        )
      }
      {
        stats?.length && (
          <dl class="not-prose mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
            {stats.map((s) => (
              <div class="border-t border-black/15 pt-2 dark:border-white/20">
                <dd class="text-xl font-semibold tabular-nums text-black dark:text-white">{s.value}</dd>
                <dt class="text-xs text-neutral-500">{s.label}</dt>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    {cover && <Image src={cover} alt="" width={1400} class="animate mb-10 w-full rounded-lg border border-black/10 dark:border-white/10" />}
    <article class="animate">
      <Content />
    </article>
    <Mermaid />

    {
      tech?.length && (
        <p class="animate mt-12 text-sm">
          <span class="text-neutral-500">기술</span> {tech.join(" · ")}
        </p>
      )
    }
    {
      next && next.id !== project.id && (
        <nav class="animate mt-10 flex justify-between gap-4 border-t border-black/15 pt-5 text-sm dark:border-white/20">
          <Link href="/resume">이력서로</Link>
          <a href={`/projects/${next.id}`} class="text-right">
            <span class="block text-xs text-neutral-500">다음 프로젝트</span>
            <span class="underline underline-offset-2">{next.data.title} ›</span>
          </a>
        </nav>
      )
    }
    <p class="animate mt-10 text-xs text-neutral-500">
      숫자는 저장소에서 센 값입니다. 화면 캡처, 업무 절차, 권한 구조, 거래처·품목·사원 정보는 싣지 않습니다.
    </p>
  </Container>
</Layout>

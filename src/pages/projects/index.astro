---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { PROJECTS } from "@consts";
import { getProjects } from "@lib/projects";

const projects = await getProjects();
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        <p class="animate text-sm text-neutral-600 dark:text-neutral-400">{PROJECTS.DESCRIPTION}</p>
        <ul class="animate not-prose flex flex-col gap-4">
          {projects.map((project) => <li><ProjectCard project={project} /></li>)}
        </ul>
      </div>
    </aside>
  </Container>
</Layout>

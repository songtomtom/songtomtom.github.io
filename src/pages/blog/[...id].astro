---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrevious from "@components/BackToPrevious.astro";
import PostNavigation from "@components/PostNavigation.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Giscus from "@components/Giscus.astro";
import ProjectSeries from "@components/ProjectSeries.astro";
import Link from "@components/Link.astro";
import { getPosts, getProjects, postsOfProject } from "@lib/projects";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const allPosts = await getPosts();

// 프로젝트에 속한 글이면 프로젝트 안에서 이전·다음 편으로 이동하고,
// 아니면 전체 글의 최신순에서 이동합니다.
const project = post.data.project
  ? (await getProjects()).find((p) => p.id === post.data.project)
  : undefined;
const seriesPosts = project ? postsOfProject(allPosts, project.id) : [];

let prevPost, nextPost;
if (project) {
  const i = seriesPosts.findIndex((p) => p.id === post.id);
  prevPost = seriesPosts[i - 1];
  nextPost = seriesPosts[i + 1];
} else {
  const i = allPosts.findIndex((p) => p.id === post.id);
  // 최신순 목록이므로 "이전 글"은 더 최신, "다음 글"은 더 오래된 글
  prevPost = allPosts[i - 1];
  nextPost = allPosts[i + 1];
}
const { Content, headings } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <Container>
    <div class="animate">
      <BackToPrevious href="/blog">글 목록으로</BackToPrevious>
    </div>
    <div class="my-10 space-y-1">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={post.data.date} />
        </div>
        &bull;
        {post.body && (
          <div class="font-base text-sm">
            {readingTime(post.body)}
          </div>
        )}        
      </div>
      <h1 class="animate text-3xl font-semibold text-black dark:text-white">
        {post.data.title}
      </h1>
      {
        post.data.tags && post.data.tags?.length > 0 ? (
          <div class="animate flex gap-2 pt-1">
            {post.data.tags.map((tag) => (
              <a
                href={`/tags/${tag}`}
                class="rounded-sm border border-black/15 px-2 py-1 text-sm transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
              >
                {tag}
              </a>
            ))}
          </div>
        ) : null
      }
    </div>
    {
      project && (
        <div class="animate mb-8">
          <ProjectSeries project={project} posts={seriesPosts} currentId={post.id} />
        </div>
      )
    }
    {headings.length > 0 && <TableOfContents headings={headings} />}
    <article class="animate">
      <Content />
      {
        post.data.canonical && (
          <p class="mt-12 text-sm text-neutral-500">
            이 글은 <Link href={post.data.canonical} external>Medium</Link>에 먼저 올린 글을 옮겨 온 것입니다.
          </p>
        )
      }
      <div class="mt-24">
        <PostNavigation prevPost={prevPost} nextPost={nextPost} />
      </div>
      <div class="mt-24">
        <Giscus />
      </div>
    </article>
  </Container>
</Layout>

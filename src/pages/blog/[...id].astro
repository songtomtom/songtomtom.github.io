---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrevious from "@components/BackToPrevious.astro";
import PostNavigation from "@components/PostNavigation.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Giscus from "@components/Giscus.astro";
import SeriesNav from "@components/SeriesNav.astro";
import Mermaid from "@components/Mermaid.astro";
import Link from "@components/Link.astro";
import { getPosts, getSeries, postsOfSeries } from "@lib/projects";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const allPosts = await getPosts();

// 시리즈에 속한 글이면 시리즈 안에서 이전·다음 편으로 이동하고,
// 아니면 전체 글의 최신순에서 이동합니다.
const series = post.data.series ? (await getSeries()).find((p) => p.id === post.data.series) : undefined;
const seriesPosts = series ? postsOfSeries(allPosts, series.id) : [];

let prevPost, nextPost;
if (series) {
  const i = seriesPosts.findIndex((p) => p.id === post.id);
  prevPost = seriesPosts[i - 1];
  nextPost = seriesPosts[i + 1];
} else {
  const i = allPosts.findIndex((p) => p.id === post.id);
  // 최신순 목록이므로 "이전 글"은 더 최신, "다음 글"은 더 오래된 글
  prevPost = allPosts[i - 1];
  nextPost = allPosts[i + 1];
}
const { Content, headings } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <Container>
    <div class="animate">
      <BackToPrevious href="/blog">글 목록으로</BackToPrevious>
    </div>
    <div class="mb-14 mt-12 space-y-3">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={post.data.date} />
        </div>
        &bull;
        {post.body && (
          <div class="font-base text-sm">
            {readingTime(post.body)}
          </div>
        )}        
      </div>
      <h1 class="animate text-3xl font-semibold leading-snug tracking-tight text-[#282828] dark:text-[#f0ece4]">
        {post.data.title}
      </h1>
      {
        post.data.tags && post.data.tags?.length > 0 ? (
          <div class="animate font-ui flex flex-wrap gap-x-2 pt-2 text-sm text-[#676767] dark:text-[#8a867e]">
            {post.data.tags.map((tag, i) => (
              <>
                {i > 0 && <span aria-hidden="true">·</span>}
                <Link href={`/tags/${tag}`}>{tag}</Link>
              </>
            ))}
          </div>
        ) : null
      }
    </div>
    {
      series && (
        <div class="animate mb-12">
          <SeriesNav series={series} posts={seriesPosts} currentId={post.id} />
        </div>
      )
    }
    {headings.length > 0 && <div class="mb-14"><TableOfContents headings={headings} /></div>}
    <article class="animate">
      <Content />
      {
        post.data.canonical && (
          <p class="mt-12 text-sm text-neutral-500">
            이 글은 <Link href={post.data.canonical} external>Medium</Link>에 먼저 올린 글을 옮겨 온 것입니다.
          </p>
        )
      }
      <div class="mt-24">
        <PostNavigation prevPost={prevPost} nextPost={nextPost} />
      </div>
      <div class="mt-24">
        <Giscus />
      </div>
    </article>
    <Mermaid />
  </Container>
</Layout>

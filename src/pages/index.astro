---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import ProjectCard from "@components/ProjectCard.astro";
import Link from "@components/Link.astro";
import { getPosts, getProjects, postsOfProject } from "@lib/projects";

const allPosts = await getPosts();
const blog = allPosts.slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
const projects = (await getProjects()).slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <h1 class="font-semibold text-black dark:text-white">
        안녕하세요, songtomtom입니다.
      </h1>
      <div class="space-y-16">
        <section>
          <article class="space-y-4">
            <span>
              <p>
                10년 넘게 웹 프론트엔드, 백엔드, 모바일 앱, 클라우드 인프라를 넘나들며 만들어 온
                풀스택 개발자입니다. 주로 Go, TypeScript, React, Flutter, Kubernetes를 사용합니다.
              </p>
              <p>
                브라우저와 하드웨어를 연결하는 웹(Web USB, Web Serial), 대규모 현장 이벤트를
                받아내는 실시간 시스템, MSA 백엔드와 배포 자동화 같은 주제를 다룹니다. 일하면서
                배운 것과 설계 판단의 이유를 기록합니다.
              </p>
            </span>
            <span class="animate">
              <p>
                경력과 기술 스택은 <Link href="/resume">이력서</Link>에 정리해 두었습니다.
              </p>
            </span>
          </article>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              최근 글
            </h2>
            <Link href="/blog"> 모든 글 보기 </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              blog.map((post) => (
                <li>
                  <ArrowCard entry={post} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              프로젝트
            </h2>
            <Link href="/projects"> 모든 프로젝트 보기 </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              projects.map((project) => (
                <li>
                  <ProjectCard project={project} postCount={postsOfProject(allPosts, project.id).length} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-4">
          <h2 class="font-semibold text-black dark:text-white">
            연락
          </h2>
          <article>
            <p>궁금한 점이나 제안이 있으면 GitHub 또는 이메일로 연락 주세요.</p>
          </article>
          <ul class="not-prose flex flex-wrap gap-2">
            {
              SOCIALS.map((SOCIAL) => (
                <li class="flex gap-x-2 text-nowrap">
                  <Link
                    href={SOCIAL.HREF}
                    external
                    aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
                  >
                    {SOCIAL.NAME}
                  </Link>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </aside>
  </Container>
</Layout>

---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { CAREER_PAGE } from "@consts";
import { Image } from "astro:assets";
import profile from "../assets/profile.jpg";
import { PROFILE, SKILLS, CAREER } from "../data/career";
---

<Layout title={CAREER_PAGE.TITLE} description={CAREER_PAGE.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-16">
        <section class="animate space-y-4">
          <div class="flex items-start justify-between gap-6">
            <div class="space-y-4">
              <h1 class="text-2xl font-semibold text-black dark:text-white">
                {PROFILE.name}
                <span class="text-base font-normal text-neutral-500">{PROFILE.handle}</span>
              </h1>
              <div class="space-y-1">
                <p class="text-[15px] leading-7 text-black dark:text-white">{PROFILE.headline}</p>
                <p class="text-[15px] leading-7 text-neutral-600 dark:text-neutral-400">{PROFILE.aim}</p>
              </div>
              <div class="space-y-3 text-[15px] leading-7">
                {PROFILE.summary.map((p) => <p>{p}</p>)}
              </div>
            </div>
            <Image
              src={profile}
              alt={`${PROFILE.name} 프로필 사진`}
              width={640}
              densities={[1, 2]}
              class="hidden w-56 shrink-0 rounded-lg sm:block sm:w-72 lg:w-80"
            />
          </div>
          <ul class="not-prose flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm">
            {
              PROFILE.contacts.map((c) => (
                <li>
                  <span class="text-neutral-500">{c.label}</span>{" "}
                  <Link href={c.href} external={c.href.startsWith("http")}>{c.text}</Link>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-4">
          <h2 class="text-[1.45rem] font-semibold tracking-tight text-[#282828] dark:text-[#f0ece4]">경력</h2>
          <ul class="space-y-4">
            {
              CAREER.map((c) => (
                <li class="grid gap-x-8 gap-y-0.5 text-[15px] sm:grid-cols-[11rem_1fr]">
                  <span class="tabular-nums text-neutral-500">{c.period}</span>
                  <div>
                    <p class="text-black dark:text-white">
                      {c.company} <span class="text-neutral-500">{c.role}</span>
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-4">
          <h2 class="text-[1.45rem] font-semibold tracking-tight text-[#282828] dark:text-[#f0ece4]">기술 스택</h2>
          <dl class="grid grid-cols-[auto_1fr] gap-x-8 gap-y-3 text-[15px]">
            {
              SKILLS.map((s) => (
                <>
                  <dt class="text-neutral-500">{s.group}</dt>
                  <dd class="text-black dark:text-white">{s.items.join(" · ")}</dd>
                </>
              ))
            }
          </dl>
        </section>

        <p class="animate text-sm text-neutral-500">상세 이력서는 요청 시 전달드립니다.</p>
      </div>
    </aside>
  </Container>
</Layout>

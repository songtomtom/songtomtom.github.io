---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { RESUME } from "@consts";
import { PROFILE, SKILLS, STRENGTHS, EXPERIENCES } from "../data/resume";

import { Image } from "astro:assets";
import profile from "../assets/profile.jpg";

---

<Layout title={RESUME.TITLE} description={RESUME.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-20">
        <section class="animate space-y-6">
          <div class="flex items-start justify-between gap-6">
            <div class="space-y-6">
              <div class="space-y-1">
                <h1 class="text-2xl font-semibold text-black dark:text-white">
                  {PROFILE.name}
                  <span class="text-base font-normal text-neutral-500">{PROFILE.handle}</span>
                </h1>
                <p class="text-[15px] leading-7 text-black dark:text-white">{PROFILE.headline}</p>
              </div>
              <div class="space-y-3 text-[15px] leading-7">
                {PROFILE.summary.map((p) => <p>{p}</p>)}
              </div>
            </div>
            <Image
              src={profile}
              alt={`${PROFILE.name} 프로필 사진`}
              width={384}
              densities={[1, 2]}
              class="hidden w-40 shrink-0 rounded-lg sm:block sm:w-48"
            />
          </div>
          <ul class="not-prose flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm">
            {
              PROFILE.contacts.map((c) => (
                <li class={c.printOnly ? "hidden print:block" : undefined}>
                  <span class="text-neutral-500">{c.label}</span>{" "}
                  <Link href={c.href} external={c.href.startsWith("http")}>
                    {c.text}
                  </Link>
                </li>
              ))
            }
            <li class="print:hidden">
              <button
                type="button"
                id="print-resume"
                class="rounded-md border border-black/15 px-2 py-0.5 text-xs text-neutral-600 transition-colors hover:bg-black/5 dark:border-white/20 dark:text-neutral-300 dark:hover:bg-white/10"
              >
                PDF로 저장
              </button>
            </li>
          </ul>
        </section>

        <section class="animate space-y-4">
          <h2 class="text-lg font-semibold text-black dark:text-white">기술 스택</h2>
          <dl class="grid grid-cols-[auto_1fr] gap-x-8 gap-y-3 text-[15px]">
            {
              SKILLS.map((s) => (
                <>
                  <dt class="text-neutral-500">{s.group}</dt>
                  <dd class="text-black dark:text-white">{s.items.join(" · ")}</dd>
                </>
              ))
            }
          </dl>
        </section>

        <section class="animate space-y-4">
          <h2 class="text-lg font-semibold text-black dark:text-white">주요 역량</h2>
          <ul class="grid gap-x-10 gap-y-3 text-[15px] leading-6 sm:grid-cols-2">
            {
              STRENGTHS.map((s) => (
                <li class="flex gap-2">
                  <span class="text-neutral-400 select-none">–</span>
                  <span>{s}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-10">
          <h2 class="text-lg font-semibold text-black dark:text-white">경력</h2>
          <ul class="space-y-16">
            {
              EXPERIENCES.map((e) => (
                <li class="space-y-6">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-black/10 pb-3 dark:border-white/15">
                    <div class="flex flex-wrap items-baseline gap-x-3">
                      <span class="text-lg font-semibold text-black dark:text-white">{e.company}</span>
                      <span class="text-sm text-neutral-500">{e.role}</span>
                    </div>
                    <span class="text-sm tabular-nums text-neutral-500">{e.period}</span>
                  </div>
                  <ul class="space-y-10">
                    {
                      e.items.map((it) => (
                        <li>
                          <details class="group">
                            <summary class="cursor-pointer list-none space-y-2.5 text-[15px] [&::-webkit-details-marker]:hidden">
                              <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5">
                                <span class="flex items-baseline gap-2 font-semibold text-black dark:text-white">
                                  <span class="inline-block w-2.5 text-[10px] text-neutral-400 transition-transform group-open:rotate-90 print:hidden">
                                    ▶
                                  </span>
                                  {it.title}
                                </span>
                                {it.period && <span class="text-xs tabular-nums text-neutral-500">{it.period}</span>}
                              </div>
                              <p class="pl-[18px] leading-6 text-neutral-700 dark:text-neutral-300">{it.highlight}</p>
                              {
                                (it.links?.length || it.project) && (
                                  <p class="flex flex-wrap gap-x-4 pl-[18px] text-sm">
                                    {it.project && <Link href={`/projects/${it.project}`}>프로젝트 자세히 보기</Link>}
                                    {it.links?.map((l) => (
                                      <Link href={l.href} external>
                                        {l.label}
                                      </Link>
                                    ))}
                                  </p>
                                )
                              }
                            </summary>
                            <div class="mt-5 space-y-5 pl-[18px] text-[15px] leading-7 text-neutral-700 dark:text-neutral-300">
                              <p>{it.summary}</p>
                              <ul class="list-disc space-y-2.5 pl-5">
                                {it.tasks.map((t) => <li>{t}</li>)}
                              </ul>
                              {
                                it.tech && (
                                  <p class="text-sm">
                                    <span class="text-neutral-500">기술</span> {it.tech.join(" · ")}
                                  </p>
                                )
                              }
                            </div>
                          </details>
                        </li>
                      ))
                    }
                  </ul>
                </li>
              ))
            }
          </ul>
        </section>

      </div>
    </aside>
  </Container>
</Layout>

<style is:global>
  @media print {
    @page {
      margin: 16mm 14mm;
    }
    header,
    footer,
    #print-resume {
      display: none !important;
    }
    html {
      color-scheme: light;
    }
    body {
      background: #fff !important;
      color: #111 !important;
      font-size: 11pt;
    }
    .animate {
      opacity: 1 !important;
      translate: none !important;
    }
    main {
      padding-top: 0 !important;
    }
    details > summary {
      cursor: default;
    }
    section,
    details {
      break-inside: avoid;
    }
    a {
      text-decoration: none;
    }
  }
</style>

<script>
  function setupPrint() {
    const btn = document.getElementById("print-resume");
    btn?.addEventListener("click", () => window.print());

    const details = () => Array.from(document.querySelectorAll<HTMLDetailsElement>("details"));
    let previouslyOpen: HTMLDetailsElement[] = [];

    window.addEventListener("beforeprint", () => {
      previouslyOpen = details().filter((d) => d.open);
      details().forEach((d) => (d.open = true));
    });
    window.addEventListener("afterprint", () => {
      details().forEach((d) => (d.open = previouslyOpen.includes(d)));
    });
  }
  setupPrint();
  document.addEventListener("astro:after-swap", setupPrint);
</script>

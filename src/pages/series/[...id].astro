---
import { render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import Link from "@components/Link.astro";
import FormattedDate from "@components/FormattedDate.astro";
import Mermaid from "@components/Mermaid.astro";
import CategoryBadge from "@components/CategoryBadge.astro";
import { Image } from "astro:assets";
import { getPosts, getSeries, postsOfSeries, type Series } from "@lib/projects";

export async function getStaticPaths() {
  const seriesList = await getSeries();
  return seriesList.map((series) => ({
    params: { id: series.id },
    props: series,
  }));
}
type Props = Series;

const series = Astro.props;
const posts = postsOfSeries(await getPosts(), series.id);
const { Content } = await render(series);
const { title, description, repoURL, demoURL, tech, date, category, cover } = series.data;
---

<Layout title={title} description={description}>
  <Container>
    <div class="animate">
      <BackToPrevious href="/series">시리즈 목록으로</BackToPrevious>
    </div>
    <div class="animate my-10 space-y-2">
      <div class="flex items-center gap-2 text-sm text-neutral-500">
        <CategoryBadge category={category} />
        <FormattedDate date={date} />
      </div>
      <h1 class="text-3xl font-semibold text-black dark:text-white">{title}</h1>
      <p class="text-black dark:text-white">{description}</p>
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm">
        {repoURL && <Link href={repoURL} external>저장소</Link>}
        {demoURL && <Link href={demoURL} external>데모</Link>}
        {tech && tech.length > 0 && <span class="text-neutral-500">{tech.join(" · ")}</span>}
      </div>
    </div>

    {cover && <Image src={cover} alt="" width={1400} class="animate mb-10 w-full rounded-lg border border-black/10 dark:border-white/10" />}
    <article class="animate">
      <Content />
    </article>
    <Mermaid />

    {
      posts.length > 0 && (
        <section class="animate mt-16 space-y-4">
          <h2 class="text-lg font-semibold text-black dark:text-white">
            글 <span class="text-sm font-normal text-neutral-500">{posts.length}편</span>
          </h2>
          <ol class="not-prose space-y-2">
            {posts.map((post, i) => (
              <li>
                <a
                  href={`/blog/${post.id}`}
                  class="group flex items-baseline gap-3 rounded-lg border border-black/15 px-4 py-3 transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white"
                >
                  <span class="w-6 shrink-0 tabular-nums text-sm text-neutral-500">{post.data.order ?? i + 1}</span>
                  <span class="flex flex-1 flex-col">
                    <span class="font-semibold">{post.data.title}</span>
                    <span class="text-sm">{post.data.description}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </Container>
</Layout>

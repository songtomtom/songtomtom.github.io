---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import SeriesCard from "@components/SeriesCard.astro";
import { SERIES } from "@consts";
import { getPosts, getSeries, postsOfSeries } from "@lib/projects";

const seriesList = await getSeries();
const posts = await getPosts();
---

<Layout title={SERIES.TITLE} description={SERIES.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        <div class="animate space-y-2">
          <h1 class="text-[1.45rem] font-semibold tracking-tight text-[#282828] dark:text-[#f0ece4]">{SERIES.TITLE}</h1>
          <p class="text-[#676767] dark:text-[#8a867e]">{SERIES.DESCRIPTION}</p>
        </div>
        <ul class="animate row-list">
          {
            seriesList.map((series) => (
              <li>
                <SeriesCard series={series} postCount={postsOfSeries(posts, series.id).length} />
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </Container>
</Layout>
